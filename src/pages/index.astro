---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroArt from "../components/HeroArt.astro";
import Devices from "../components/Devices.astro";
import AdminPanel from "../components/AdminPanel.astro";
import DevicesVideo from "../components/DevicesVideo.astro";
import PanelVideo from "../components/PanelVideo.astro";
import CtaBand from "../components/CtaBand.astro";
import AssistenteShowcase from "../components/AssistenteShowcase.astro";
import { productMedia, audiences, packageJourney, featureGroups, trustPoints, faq } from "../data/site.js";

const video = productMedia === "video";
const coreGroups = featureGroups.filter((g) => g.id !== "em-breve");
---

<BaseLayout path="/">
  <!-- 1. Promessa -->
  <section class="hero">
    <div class="wrap hero__in">
      <div>
        <h1 class="display">O condomínio em ordem, do portão ao apartamento.</h1>
        <p class="lead">
          CondoSmart é a plataforma da Arcanos para síndicos, administradoras e portarias.
          Encomendas, visitantes, reservas e comunicados num só lugar, com o Marquinhos, um assistente
          de IA que responde pelo regimento e faz o que cada um pode fazer.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--ouro" href="/contato/">Agendar demonstração</a>
          <a class="btn btn--linha" href="/funcionalidades/">Ver funcionalidades</a>
        </div>
        <p class="hero__note">Já usa o CondoSmart? <a class="link" href="/entrar/">Entre na sua conta</a></p>
      </div>
      <HeroArt />
    </div>
    <div class="hero__strip">
      <ul class="wrap">
        <li><strong>Assistente de IA</strong>Responde pelo regimento e faz pelo chat.</li>
        <li><strong>Módulos por contrato</strong>Ligue só o que o condomínio usa.</li>
        <li><strong>Dados isolados</strong>Cada condomínio separado, com LGPD aplicada.</li>
        <li><strong>Em operação real</strong>Nasceu numa portaria em São Paulo.</li>
      </ul>
    </div>
  </section>

  <!-- 2. Para quem -->
  <section class="sec" id="para-quem">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Para quem é</p>
        <h2 class="h2">Cada pessoa do condomínio vê a parte que lhe cabe.</h2>
      </div>
      <div class="aud" data-tabs>
        <div class="aud__tabs" role="tablist" aria-label="Perfis">
          {audiences.map((a, i) => (
            <button class="aud__tab" role="tab" id={`tab-${a.id}`} aria-controls={`painel-${a.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              {a.name}
            </button>
          ))}
        </div>
        {audiences.map((a, i) => (
          <div class="aud__panel" role="tabpanel" id={`painel-${a.id}`} aria-labelledby={`tab-${a.id}`} hidden={i !== 0}>
            <div>
              <p class="aud__pain">{a.pain}</p>
              <p class="aud__gain">{a.gain}</p>
            </div>
            <ul class="checks">{a.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Marquinhos -->
  <section class="sec sec--noite on-dark" id="assistente">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Assistente de IA</p>
        <h2 class="h2">Conheça o Marquinhos. Ele leu o regimento e sabe usar o app.</h2>
        <p class="lead muted">O morador pergunta, a portaria pede, o síndico consulta. O Marquinhos responde com a fonte e faz o que a função de cada um permite, sempre com confirmação.</p>
      </div>
      <AssistenteShowcase />
    </div>
  </section>

  <!-- 4. A jornada da encomenda -->
  <section class="sec sec--noite on-dark sec--fundo">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Encomendas</p>
        <h2 class="h2">A encomenda que chega às 14h não pode virar problema às 22h.</h2>
        <p class="lead muted">É a dor número um da portaria. Por isso foi a primeira coisa que resolvemos.</p>
      </div>
      <ol class="journey">
        {packageJourney.map((s) => (
          <li><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>

      <div class="showcase">
        {video ? (
          <div class="showcase__copy">
            <h3 class="h2" style="font-size:clamp(1.5rem,2.6vw,2rem)">A portaria sabe o que entregar primeiro.</h3>
            <p class="lead muted" style="margin-top:1rem">
              Remédios, perecíveis e correspondência judicial aparecem no topo, com o tempo de espera de cada uma.
              Do outro lado, o morador vê a encomenda no app assim que ela é registrada.
            </p>
            <ul class="checks">
              <li>Retirada urgente separada do resto, com instrução para cada tipo</li>
              <li>Retirada pelo QR Code da portaria, confirmada pelo porteiro</li>
              <li>Retirada por terceiros com autorização do morador</li>
            </ul>
            <p class="video-note">Gravado no condomínio de demonstração, com dados fictícios.</p>
          </div>
        ) : (
          <div class="showcase__copy">
            <h3 class="h2" style="font-size:clamp(1.5rem,2.6vw,2rem)">O porteiro aponta a câmera. O sistema faz o resto.</h3>
            <p class="lead muted" style="margin-top:1rem">
              O Modo Expresso lê o código de barras ou o texto da etiqueta, sugere a unidade e deixa os
              avisos para o fim do lote. Em dia de pico, ninguém digita endereço.
            </p>
            <ul class="checks">
              <li>Busca a unidade com ou sem bloco, com ou sem zero à esquerda</li>
              <li>Foto do pacote anexada ao registro</li>
              <li>Retirada por terceiros com autorização do morador</li>
            </ul>
          </div>
        )}
        {video ? <DevicesVideo /> : <Devices />}
      </div>
    </div>
  </section>

  <!-- 4. O que tem -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Funcionalidades</p>
        <h2 class="h2">Da portaria à prestação de contas.</h2>
        <p class="lead muted">Os módulos são ligados por condomínio. Comece pelo que mais pesa e amplie quando fizer sentido.</p>
      </div>
      <div class="modrow">
        {coreGroups.map((g) => (
          <div>
            <h3 class="h3">{g.title}</h3>
            <p>{g.summary}</p>
            <ul>{g.features.slice(0, 5).map((f) => <li>{f.name}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="center-cta"><a class="btn btn--linha" href="/funcionalidades/">Ver todas as funcionalidades</a></div>
    </div>
  </section>

  <!-- 5. Visão do síndico -->
  <section class="sec sec--branco">
    <div class="wrap split">
      <div>
        <p class="kicker">Para o síndico</p>
        <h2 class="h2">Responda ao conselho com dados, não com memória.</h2>
        <p class="lead muted" style="margin-top:1rem">
          Quantas encomendas chegaram, quais estão paradas, quem estava de plantão, quais reservas foram
          aprovadas. Tudo em relatório, com exportação em PDF e planilha.
        </p>
        <ul class="checks mt-2">
          <li>Produtividade da portaria por porteiro</li>
          <li>Trilha de auditoria das operações sensíveis</li>
          <li>Comunicados com escolha de canal: push, e-mail ou ambos</li>
        </ul>
      </div>
      {video ? <PanelVideo /> : <AdminPanel />}
    </div>
  </section>

  <!-- 6. Confiança -->
  <section class="sec sec--noite on-dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Segurança e LGPD</p>
        <h2 class="h2">Dados de moradores são responsabilidade do síndico. Cuidamos deles como se fossem nossos.</h2>
      </div>
      <div class="trust">
        {trustPoints.map((t) => (<div><h3>{t.title}</h3><p>{t.text}</p></div>))}
      </div>
      <div class="center-cta"><a class="btn btn--linha" style="color:#fff;border-color:rgba(255,255,255,.4)" href="/seguranca/">Como tratamos os dados</a></div>
    </div>
  </section>

  <!-- 7. Origem real -->
  <section class="sec">
    <div class="wrap case">
      <figure style="margin:0">
        <blockquote>
          O CondoSmart não nasceu numa sala de reunião. Nasceu no balcão de uma portaria, entre o
          interfone e a pilha de caixas.
        </blockquote>
        <figcaption>
          Desenvolvido junto com a equipe do Condomínio TEG Vila Guilherme, em São Paulo, onde está em operação.
        </figcaption>
        <!-- TODO(marketing): trocar por depoimento real e assinado do síndico, com autorização por escrito. -->
      </figure>
      <ul class="case__facts">
        <li><span>Onde</span><b>TEG Vila Guilherme, São Paulo</b></li>
        <li><span>Quem usa</span><b>Portaria, síndico e moradores</b></li>
        <li><span>Em uso</span><b>Encomendas, reservas, comunicados e relatórios</b></li>
        <li><span>Como evolui</span><b>Melhorias a partir do uso diário</b></li>
      </ul>
    </div>
  </section>

  <!-- 9. Dúvidas -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2 class="h2">Perguntas frequentes</h2></div>
      <div class="faq">
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
