---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
---

<BaseLayout title="Página não encontrada | CondoSmart" description="A página procurada não existe." path="/404" noIndex={true}>
  <PageHead title="Esta página não existe." lead="O endereço pode ter mudado. Escolha para onde seguir.">
    <div class="hero__ctas">
      <a class="btn btn--ouro" href="/">Página inicial</a>
      <a class="btn btn--linha" style="color:#fff" href="/entrar/">Entrar no CondoSmart</a>
    </div>
  </PageHead>
</BaseLayout>
