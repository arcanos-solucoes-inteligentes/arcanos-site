---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada | Arcanos"
  description="A página solicitada não foi encontrada."
  path="/404"
  noIndex={true}
>
  <section class="section section--dark not-found">
    <div class="container not-found__content" data-reveal>
      <p class="eyebrow">Erro 404</p>
      <h1>Esta página não foi encontrada.</h1>
      <p>Volte para a página inicial para continuar conhecendo a proposta institucional da Arcanos.</p>
      <a class="button" href="/">Ir para a home</a>
    </div>
  </section>
</BaseLayout>
