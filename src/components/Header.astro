---
import { company, navigation } from "../data/site.js";
const { path = "/" } = Astro.props;
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href="/" aria-label="Arcanos, página inicial">
      <img src={company.brandLogo} alt="" width="195" height="45" />
      <span class="brand__product">{company.product}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>Menu</button>

    <nav class="nav" id="nav" aria-label="Principal" data-nav>
      <ul class="nav__links">
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav__cta">
        <a class="btn btn--linha btn--sm" href="/entrar/">Entrar</a>
        <a class="btn btn--ouro btn--sm" href="/contato/">Agendar demonstração</a>
      </div>
    </nav>
  </div>
</header>
