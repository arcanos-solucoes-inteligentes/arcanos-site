---
// Fachada noturna com o rastro dourado: o caminho da encomenda, da portaria
// até a janela do apartamento que recebe o aviso. É o único momento animado do site.
const towers = [
  { x: 150, y: 90, cols: 5, rows: 11 },
  { x: 330, y: 40, cols: 5, rows: 13 }
];
const W = 18, H = 14, GX = 10, GY = 16;
const target = { tower: 1, col: 3, row: 3 };
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const windows = [];
towers.forEach((t, ti) => {
  for (let r = 0; r < t.rows; r++) {
    for (let c = 0; c < t.cols; c++) {
      const isTarget = ti === target.tower && r === target.row && c === target.col;
      windows.push({
        x: t.x + 14 + c * (W + GX),
        y: t.y + 18 + r * (H + GY),
        cls: isTarget ? "win win--alvo" : rnd() > 0.62 ? "win win--on" : "win"
      });
    }
  }
});
const tgt = windows.find((w) => w.cls.includes("alvo"));
const tx = tgt.x + W / 2, ty = tgt.y + H / 2;
const trail = `M 40 470 C 120 470, 110 440, 118 430 S 250 420, 290 400 S 300 300, 270 250 S 300 150, ${tx} ${ty}`;
---

<div class="hero__art" aria-hidden="true">
  <svg class="facade" viewBox="0 0 520 500" preserveAspectRatio="xMidYMax meet">
    <defs>
      <linearGradient id="rastro" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#d88900" />
        <stop offset=".6" stop-color="#f4b942" />
        <stop offset="1" stop-color="#ffe3a3" />
      </linearGradient>
      <linearGradient id="torre" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0f2042" />
        <stop offset="1" stop-color="#091631" />
      </linearGradient>
    </defs>

    {towers.map((t) => (
      <rect x={t.x} y={t.y} width={t.cols * (W + GX) + 18} height={500 - t.y - 30} fill="url(#torre)" rx="3" />
    ))}
    {windows.map((w) => <rect class={w.cls} x={w.x} y={w.y} width={W} height={H} rx="1.5" />)}

    <!-- portaria -->
    <rect x="20" y="440" width="70" height="30" rx="3" fill="#13254a" />
    <rect x="30" y="448" width="22" height="14" rx="1.5" fill="#f4c46a" />
    <rect x="0" y="470" width="520" height="30" fill="#020817" />

    <path class="trail-soft" d={trail} />
    <path class="trail" d={trail} />
    <circle cx={tx} cy={ty} r="5" fill="#ffe3a3" />
  </svg>

  <div class="notif">
    <div class="notif__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f4b942" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
    </div>
    <div>
      <p class="notif__app"><span>CondoSmart</span><span>agora</span></p>
      <p class="notif__title">Sua encomenda chegou</p>
      <p class="notif__body">Apto 72, Bloco B. Para retirar, escaneie o QR Code da portaria.</p>
    </div>
  </div>
</div>
