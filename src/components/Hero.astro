---
interface HeroCompany {
  tagline: string;
  heroText: string;
  heroImage: string;
  brandQuote: string;
}

const { company, highlights } = Astro.props as {
  company: HeroCompany;
  highlights: string[];
};
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content" data-reveal>
      <p class="eyebrow">Apresentação institucional</p>
      <h1>{company.tagline}</h1>
      <p class="hero__text">{company.heroText}</p>
      <p class="hero__support">
        Neste primeiro momento, queremos apresentar quem somos, o que nos move e o que já
        estamos colocando em prática.
      </p>
      <div class="hero__actions">
        <a class="button" href="#contato">Entrar em contato</a>
        <a class="button button--secondary" href="#quem-somos">Conhecer a Arcanos</a>
      </div>
      <ul class="hero__highlights">
        {highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" data-reveal>
      <img
        src={company.heroImage}
        alt="Arte institucional da Arcanos com skyline, marca e rastro dourado."
        width="720"
        height="540"
      />
      <div class="hero__quote-card">
        <p>{company.brandQuote}</p>
      </div>
      <img
        class="hero__trail"
        src="/images/decorative/trail-gold.svg"
        alt=""
        width="220"
        height="220"
      />
    </div>
  </div>
</section>
